+++ b/core/tests/Drupal/KernelTests/Core/DefaultContent/ImporterTest.php
@@ -6,9 +6,11 @@
 
 use Drupal\Core\DefaultContent\Finder;
 use Drupal\Core\DefaultContent\Importer;
+use Drupal\Core\DefaultContent\ImportException;
 use Drupal\Core\DefaultContent\PreEntityImportEvent;
 use Drupal\Core\Entity\ContentEntityInterface;
 use Drupal\Core\Entity\EntityRepositoryInterface;
+use Drupal\Core\Entity\EntityTypeManagerInterface;
 use Drupal\Core\Hook\Attribute\Hook;
 use Drupal\KernelTests\KernelTestBase;
 use Drupal\Tests\user\Traits\UserCreationTrait;
@@ -103,4 +105,37 @@ public function testChangeDataOnImport(): void {
     self::assertSame('Changed name', $entity?->label());
   }
 
+  /**
+   * Tests that a circular dependency aborts the import before anything is saved.
+   *
+   * The fixture contains two entities whose `_meta.depends` declarations form a
+   * cycle. The Finder must detect this and throw, so that ::importContent() is
+   * never reached and no partially-resolved entities are written to storage.
+   */
+  public function testCircularDependencyImportFailsBeforeWrite(): void {
+    $this->setUpCurrentUser(admin: TRUE);
+
+    $storage = $this->container->get(EntityTypeManagerInterface::class)
+      ->getStorage('entity_test');
+    // Sanity check: nothing has been imported yet.
+    self::assertSame(0, (int) $storage->getQuery()->accessCheck(FALSE)->count()->execute());
+
+    $dir = $this->getDrupalRoot() . '/core/tests/fixtures/default_content_circular_entity_test';
+    try {
+      $finder = new Finder($dir);
+      $this->container->get(Importer::class)->importContent($finder);
+      $this->fail('Expected an ImportException to be thrown for a circular dependency.');
+    }
+    catch (ImportException $e) {
+      $message = $e->getMessage();
+      self::assertStringStartsWith('The following default content entities form a circular dependency: ', $message);
+      self::assertStringContainsString($dir . '/entity_test/aaaaaaaa-0000-4000-8000-000000000001.yml', $message);
+      self::assertStringContainsString($dir . '/entity_test/bbbbbbbb-0000-4000-8000-000000000002.yml', $message);
+    }
+
+    // The import must have failed before writing anything: no entity_test
+    // entities should exist.
+    self::assertSame(0, (int) $storage->getQuery()->accessCheck(FALSE)->count()->execute());
+  }
+
 }
diff --git a/core/tests/Drupal/Tests/Core/DefaultContent/FinderTest.php b/core/tests/Drupal/Tests/Core/DefaultContent/FinderTest.php
index 5def87a3..72c28f0b 100644
--- a/core/tests/Drupal/Tests/Core/DefaultContent/FinderTest.php
+++ b/core/tests/Drupal/Tests/Core/DefaultContent/FinderTest.php
@@ -8,6 +8,7 @@
 use Drupal\Core\DefaultContent\ImportException;
 use Drupal\Tests\UnitTestCase;
 use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\Attributes\DataProvider;
 use PHPUnit\Framework\Attributes\Group;
 
 /**
@@ -82,4 +83,74 @@ public function testExceptionIfNoUuid(): void {
     new Finder(__DIR__ . '/../../../../fixtures/default_content_broken');
   }
 
+  /**
+   * Tests that a circular dependency between entities raises an exception.
+   *
+   * When entities' `_meta.depends` declarations form a cycle there is no valid
+   * dependency order, so the Finder must fail fast and name every file involved
+   * in the cycle, rather than producing an arbitrary order that would cause
+   * references to resolve to nothing (or fatal) during import.
+   *
+   * @param string $fixture
+   *   The name of the fixture directory, relative to the fixtures directory.
+   * @param string[] $expected_files
+   *   The entity file names, relative to the fixture directory, that must all
+   *   appear in the exception message.
+   */
+  #[DataProvider('providerCircularDependency')]
+  public function testExceptionOnCircularDependency(string $fixture, array $expected_files): void {
+    $dir = __DIR__ . '/../../../../fixtures/' . $fixture;
+
+    try {
+      new Finder($dir);
+      $this->fail('Expected an ImportException to be thrown for a circular dependency.');
+    }
+    catch (ImportException $e) {
+      $message = $e->getMessage();
+      $this->assertStringStartsWith('The following default content entities form a circular dependency: ', $message);
+      // Every file participating in the cycle must be named in the message.
+      foreach ($expected_files as $file) {
+        $this->assertStringContainsString($dir . '/' . $file, $message);
+      }
+    }
+  }
+
+  /**
+   * Data provider for ::testExceptionOnCircularDependency().
+   */
+  public static function providerCircularDependency(): array {
+    return [
+      // The canonical case: a three-node cycle A → B → C → A. This is the crux
+      // of the bug — a cycle check that only inspects a vertex's own reachable
+      // paths would name the cycle's entry vertices but omit the back-edge
+      // vertex, so all three files must be named.
+      'three-node cycle' => [
+        'default_content_circular',
+        [
+          'node/aaaaaaaa-aaaa-4aaa-aaaa-aaaaaaaaaaaa.yml',
+          'node/bbbbbbbb-bbbb-4bbb-bbbb-bbbbbbbbbbbb.yml',
+          'node/cccccccc-cccc-4ccc-cccc-cccccccccccc.yml',
+        ],
+      ],
+      // A self-loop: an entity that lists itself as a dependency.
+      'self-referencing entity' => [
+        'default_content_circular_self',
+        [
+          'node/dddddddd-dddd-4ddd-dddd-dddddddddddd.yml',
+        ],
+      ],
+      // Two independent two-node cycles in the same directory. Every file in
+      // every cycle must be named, not just those of the first cycle found.
+      'two disjoint cycles' => [
+        'default_content_circular_disjoint',
+        [
+          'node/eeeeeeee-eeee-4eee-eeee-eeeeeeeeeeee.yml',
+          'node/ffffffff-ffff-4fff-ffff-ffffffffffff.yml',
+          'node/11111111-1111-4111-9111-111111111111.yml',
+          'node/22222222-2222-4222-9222-222222222222.yml',
+        ],
+      ],
+    ];
+  }
+
 }
