diff --git a/core/lib/Drupal/Core/DefaultContent/Finder.php b/core/lib/Drupal/Core/DefaultContent/Finder.php
index edbc69e3..5e875f33 100644
--- a/core/lib/Drupal/Core/DefaultContent/Finder.php
+++ b/core/lib/Drupal/Core/DefaultContent/Finder.php
@@ -78,6 +78,38 @@ public function __construct(string $path) {
     // entities should come first.
     $graph_object = new Graph($graph);
     $sorted = $graph_object->searchAndSort();
+
+    // A circular dependency (e.g. A → B → C → A) has no valid topological
+    // order, but ::searchAndSort() will still return an arbitrary one.
+    // Importing in that order would resolve at least one reference before its
+    // target exists, silently producing an empty reference or a fatal error.
+    // Detect cycles here and fail fast instead.
+    //
+    // After ::searchAndSort(), a vertex's 'paths' lists every vertex reachable
+    // from it, and 'reverse_paths' lists every vertex that can reach it. A
+    // vertex is part of a cycle if it can reach itself. The intersection of its
+    // 'paths' and 'reverse_paths' is exactly its strongly connected component,
+    // i.e. the full set of vertices in the cycle — including the back-edge
+    // vertex, which does not list itself in its own 'paths'.
+    $cycle = [];
+    foreach ($sorted as $uuid => $vertex) {
+      if (isset($vertex['paths'][$uuid])) {
+        $cycle += array_intersect_key($vertex['paths'], $vertex['reverse_paths'] ?? []);
+      }
+    }
+    if ($cycle) {
+      // Name the source file of each entity in the cycle. Every entity in a
+      // cycle is backed by a file, because a dependency that has no file of its
+      // own is only ever an edge target and so cannot depend on anything; the
+      // null coalesce is therefore only a defensive guard for the return type.
+      $in_cycle = array_map(
+        fn (string $uuid): string => $files[$uuid]['_meta']['path'] ?? $uuid,
+        array_keys($cycle),
+      );
+      sort($in_cycle);
+      throw new ImportException('The following default content entities form a circular dependency: ' . implode(', ', $in_cycle) . '.');
+    }
+
     uasort($sorted, SortArray::sortByWeightElement(...));
 
     $entities = [];
diff --git a/core/tests/Drupal/KernelTests/Core/DefaultContent/ImporterTest.php b/core/tests/Drupal/KernelTests/Core/DefaultContent/ImporterTest.php
