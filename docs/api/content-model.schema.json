    "$comment": "The $defs below are simplified logical-node validation schemas (flat field map) for checking a payload before writing through the editorial workflow. They are NOT the JSON:API wire format (which splits attributes/relationships). Reference fields accept an array of UUIDs.",
    "$defs": {
        "textLong": {
            "type": "object",
            "required": [
                "value"
            ],
            "properties": {
                "value": {
                    "type": "string"
                },
                "format": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        },
        "textWithSummary": {
            "type": "object",
            "required": [
                "value"
            ],
            "properties": {
                "value": {
                    "type": "string"
                },
                "summary": {
                    "type": "string"
                },
                "format": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        },
        "link": {
            "type": "object",
            "required": [
                "uri"
            ],
            "properties": {
                "uri": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        },
        "refList": {
            "type": "array",
            "items": {
                "type": "string",
                "format": "uuid"
            }
        },
        "service": {
            "type": "object",
            "required": [
                "title",
                "field_direct_answer",
                "field_summary",
                "field_next_action",
                "field_reviewed_date",
                "field_topic"
            ],
            "properties": {
                "title": {
                    "type": "string"
                },
                "field_direct_answer": {
                    "$ref": "#/$defs/textLong"
                },
                "field_summary": {
                    "$ref": "#/$defs/textLong"
                },
                "field_problem_solved": {
                    "$ref": "#/$defs/textLong"
                },
                "field_eligibility": {
                    "$ref": "#/$defs/textLong"
                },
                "field_next_action": {
                    "$ref": "#/$defs/link"
                },
                "field_reviewed_date": {
                    "type": "string"
                },
                "field_reviewed_by_name": {
                    "type": "string"
                },
                "field_topic": {
                    "$ref": "#/$defs/refList"
                },
                "field_audience": {
                    "$ref": "#/$defs/refList"
                },
                "field_evidence_sources": {
                    "$ref": "#/$defs/refList"
                },
                "field_sections": {
                    "$ref": "#/$defs/refList"
                }
            }
        },
        "answer": {
            "type": "object",
            "required": [
                "title",
                "field_direct_answer",
                "field_reviewed_date",
                "field_topic"
            ],
            "properties": {
                "title": {
                    "type": "string"
                },
                "field_direct_answer": {
                    "$ref": "#/$defs/textLong"
                },
                "body": {
                    "$ref": "#/$defs/textWithSummary"
                },
                "field_reviewed_date": {
                    "type": "string"
                },
                "field_reviewed_by_name": {
                    "type": "string"
                },
                "field_topic": {
                    "$ref": "#/$defs/refList"
                },
                "field_audience": {
                    "$ref": "#/$defs/refList"
                },
                "field_related_services": {
                    "$ref": "#/$defs/refList"
                },
                "field_evidence_sources": {
                    "$ref": "#/$defs/refList"
                },
                "field_sections": {
                    "$ref": "#/$defs/refList"
                }
            }
        },
        "article": {
            "type": "object",
            "required": [
                "title",
                "field_summary",
                "body",
                "field_reviewed_date"
            ],
            "properties": {
                "title": {
                    "type": "string"
                },
                "field_summary": {
                    "$ref": "#/$defs/textLong"
                },
                "body": {
                    "$ref": "#/$defs/textWithSummary"
                },
                "field_author_name": {
                    "type": "string"
                },
                "field_reviewed_date": {
                    "type": "string"
                },
                "field_reviewed_by_name": {
                    "type": "string"
                },
                "field_topic": {
                    "$ref": "#/$defs/refList"
                },
                "field_audience": {
                    "$ref": "#/$defs/refList"
                },
                "field_related_services": {
                    "$ref": "#/$defs/refList"
                },
                "field_related_answers": {
                    "$ref": "#/$defs/refList"
                },
                "field_evidence_sources": {
                    "$ref": "#/$defs/refList"
                },
                "field_sections": {
                    "$ref": "#/$defs/refList"
                }
            }
        },
        "evidence_source": {
            "type": "object",
            "required": [
                "title",
                "field_publisher",
                "field_source_url",
                "field_source_type"
            ],
            "properties": {
                "title": {
                    "type": "string"
                },
                "field_publisher": {
                    "type": "string"
                },
                "field_source_url": {
                    "$ref": "#/$defs/link"
                },
                "field_source_type": {
                    "type": "string",
                    "enum": [
                        "guideline",
                        "policy",
                        "research",
                        "program_page",
                        "dataset",
                        "faq",
                        "other"
                    ]
                },
                "field_publication_date": {
                    "type": "string"
                },
                "field_credibility_note": {
                    "$ref": "#/$defs/textLong"
                },
                "field_topic": {
                    "$ref": "#/$defs/refList"
                }
            }
        }
    }
