                    "required": true,
                    "reference": {
                        "targetType": "taxonomy_term",
                        "targetBundles": [
                            "topic"
                        ]
                    }
                }
            ]
        },
        "article": {
            "jsonapiType": "node--article",
            "schemaOrg": [
                "Article",
                "WebPage",
                "BreadcrumbList"
            ],
            "description": "A longer-form article with a summary, body, author, and provenance.",
            "fields": [
                {
                    "machineName": "title",
                    "label": "Title",
                    "drupalType": "string",
                    "cardinality": 1,
                    "required": true,
                    "base": true
                },
                {
                    "machineName": "body",
                    "label": "Body",
                    "drupalType": "text_with_summary",
                    "cardinality": 1,
                    "required": true
                },
                {
                    "machineName": "field_audience",
