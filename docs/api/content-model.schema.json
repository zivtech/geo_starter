                    "cardinality": 1,
                    "required": true
                },
                {
                    "machineName": "field_evidence_sources",
                    "label": "Evidence sources",
                    "drupalType": "entity_reference",
                    "cardinality": "unlimited",
                    "required": false,
                    "reference": {
                        "targetType": "node",
