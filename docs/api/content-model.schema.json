{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://git.drupalcode.org/project/geo_starter/-/raw/1.1.0/docs/api/content-model.schema.json",
    "title": "GEO Starter Content Model",
    "description": "Versioned, machine-readable description of the GEO Starter content model: node types, fields, reference targets, the editorial workflow, and schema.org mappings. Agents fetch this to resolve stale training data (Drupal training data skews to D7) and to know the exact field machine names before reading or writing via JSON:API. Generated from config/ by tools/generate-content-model-schema.php — do not hand-edit; regenerate on content-model changes.",
    "version": "1.0.0",
    "generatedFrom": "config/ (node.type.*, field.field.node.*, field.storage.node.*, workflows.workflow.geo_starter_editorial)",
    "stability": "Within the 1.x line the content model, @id scheme, and entity-type set are FROZEN (additive-only): no field deletions, no field-type/storage changes, no vocabulary restructuring. New optional fields/bundles may be added (minor version bump). Breaking changes force 2.0.0. Match this document's version against the recipe version to detect staleness.",
    "drupal": {
        "distribution": "Drupal CMS",
        "entityType": "node",
        "jsonapiBase": "/jsonapi",
        "jsonapiAccess": "Anonymous JSON:API exposes PUBLISHED public content only. Draft/unpublished nodes and Paragraph revisions are not exposed anonymously.",
        "moduleProviders": {
            "jsonld": "drupal/geo_starter_jsonld (separate package) emits one parity-correct schema.org @graph per published canonical page."
        }
    },
    "workflow": {
        "id": "geo_starter_editorial",
        "type": "content_moderation",
        "appliesTo": [
            "node:service",
            "node:answer",
            "node:article",
            "node:evidence_source"
        ],
        "defaultState": "draft",
        "states": {
            "archived": {
                "label": "Archived",
                "published": false
            },
            "draft": {
                "label": "Draft",
                "published": false
            },
            "needs_review": {
                "label": "Needs review",
                "published": false
            },
            "published": {
                "label": "Published",
                "published": true
            }
        },
        "transitions": {
            "create_new_draft": {
                "label": "Create new draft",
                "to": "draft"
            },
            "send_to_review": {
                "label": "Send to review",
                "to": "needs_review"
            },
            "publish": {
                "label": "Publish",
                "to": "published"
            },
            "archive": {
                "label": "Archive",
                "to": "archived"
            }
        },
        "writeRule": "Content is created/updated through the editorial workflow; new content starts in `draft` and publication requires the `publish` transition (a human editor, or a role explicitly granted it)."
    },
    "vocabularies": {
        "topic": {
            "machineName": "topic",
            "label": "Topic",
            "description": "Controlled subject taxonomy used by field_topic."
        },
        "audience": {
            "machineName": "audience",
            "label": "Audience",
            "description": "Controlled audience taxonomy used by field_audience."
        }
    },
    "fieldTypeLegend": {
        "string": {
            "json": "string",
            "notes": "Plain text, single line."
        },
        "text_long": {
            "json": "object",
            "notes": "{ value: string, format: string }. Format is typically `content_format`."
        },
        "text_with_summary": {
            "json": "object",
            "notes": "{ value: string, summary: string, format: string }."
        },
        "datetime": {
            "json": "string",
            "notes": "ISO date, e.g. 2026-05-29 (date-only for reviewed/publication dates)."
        },
        "link": {
            "json": "object",
            "notes": "{ uri: string, title: string }. uri may be an absolute URL or internal:/ path."
        },
        "list_string": {
            "json": "string",
            "notes": "One of an enumerated allowed-values set."
        },
        "entity_reference": {
            "json": "array",
            "notes": "Reference(s) to taxonomy_term or node; JSON:API exposes as a relationship."
        },
        "entity_reference_revisions": {
            "json": "array",
            "notes": "Paragraph revision reference(s); composed section content."
        }
    },
    "contentTypes": {
        "service": {
            "jsonapiType": "node--service",
            "schemaOrg": [
                "Service",
                "WebPage",
                "BreadcrumbList"
            ],
            "description": "A service a public-sector body offers, with eligibility, a direct answer, a next action, and provenance.",
            "fields": [
                {
                    "machineName": "title",
                    "label": "Title",
                    "drupalType": "string",
                    "cardinality": 1,
                    "required": true,
                    "base": true
                },
                {
                    "machineName": "field_audience",
                    "label": "Audience",
                    "drupalType": "entity_reference",
                    "cardinality": "unlimited",
                    "required": false,
                    "reference": {
                        "targetType": "taxonomy_term",
                        "targetBundles": [
                            "audience"
                        ]
                    }
                },
                {
                    "machineName": "field_direct_answer",
                    "label": "Direct answer",
                    "drupalType": "text_long",
                    "cardinality": 1,
                    "required": true
                },
                {
                    "machineName": "field_eligibility",
                    "label": "Eligibility",
                    "drupalType": "text_long",
                    "cardinality": 1,
                    "required": false
                },
                {
                    "machineName": "field_evidence_sources",
                    "label": "Evidence sources",
                    "drupalType": "entity_reference",
                    "cardinality": "unlimited",
                    "required": false,
                    "reference": {
                        "targetType": "node",
                        "targetBundles": [
                            "evidence_source"
                        ]
                    }
                },
                {
                    "machineName": "field_next_action",
                    "label": "Next action",
                    "drupalType": "link",
                    "cardinality": 1,
                    "required": true
                },
                {
                    "machineName": "field_problem_solved",
                    "label": "Problem solved",
                    "drupalType": "text_long",
                    "cardinality": 1,
                    "required": false
                },
                {
                    "machineName": "field_reviewed_by_name",
                    "label": "Reviewed by",
                    "drupalType": "string",
                    "cardinality": 1,
                    "required": false
                },
                {
                    "machineName": "field_reviewed_date",
                    "label": "Last reviewed",
                    "drupalType": "datetime",
                    "cardinality": 1,
                    "required": true
                },
                {
                    "machineName": "field_sections",
                    "label": "Sections",
                    "drupalType": "entity_reference_revisions",
                    "cardinality": "unlimited",
                    "required": false,
                    "reference": {
                        "targetType": "paragraph",
                        "targetBundles": [
                            "geo_starter_section",
                            "section_card_grid",
                            "section_contact_panel",
                            "section_faq",
                            "section_step_list",
                            "section_cta",
                            "section_alert",
                            "section_media_text"
                        ]
                    }
                },
                {
                    "machineName": "field_summary",
                    "label": "Summary",
                    "drupalType": "text_long",
                    "cardinality": 1,
                    "required": true
                },
                {
                    "machineName": "field_topic",
                    "label": "Topic",
                    "drupalType": "entity_reference",
                    "cardinality": "unlimited",
                    "required": true,
                    "reference": {
                        "targetType": "taxonomy_term",
                        "targetBundles": [
                            "topic"
                        ]
                    }
                }
            ]
        },
        "answer": {
            "jsonapiType": "node--answer",
            "schemaOrg": [
                "Question",
