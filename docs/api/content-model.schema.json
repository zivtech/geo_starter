                    "label": "Related services",
                    "drupalType": "entity_reference",
                    "cardinality": "unlimited",
                    "required": false,
                    "reference": {
                        "targetType": "node",
                        "targetBundles": [
                            "service"
                        ]
                    }
                },
                {
                    "machineName": "field_reviewed_by_name",
                    "label": "Reviewed by",
                    "drupalType": "string",
                    "cardinality": 1,
                    "required": false
                },
                {
                    "machineName": "field_reviewed_date",
                    "label": "Last reviewed",
                    "drupalType": "datetime",
                    "cardinality": 1,
                    "required": true
                },
                {
                    "machineName": "field_sections",
                    "label": "Sections",
                    "drupalType": "entity_reference_revisions",
                    "cardinality": "unlimited",
                    "required": false,
                    "reference": {
                        "targetType": "paragraph",
                        "targetBundles": [
                            "geo_starter_section",
                            "section_step_list"
                        ]
                    }
                },
                {
                    "machineName": "field_topic",
                    "label": "Topic",
